{
    "name": "horde/ldap",
    "description": "LDAP client library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Ldap",
    "license": "LGPL-3.0-only",
    "authors": [
        {
            "name": "Ben Klang",
            "email": "ben@alkaloid.net",
            "role": "lead"
        },
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        }
    ],
    "time": "2026-03-27",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/exception": "^3",
        "horde/util": "^3",
        "ext-ldap": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2"
    },
    "autoload": {
        "psr-0": {
            "Horde_Ldap": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Ldap\\Test\\Unit\\": "test/Unit/",
            "Horde\\Ldap\\Test\\Live\\": "test/Live/",
            "Horde\\Ldap\\Test\\Fixtures\\": "test/Fixtures/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}